{
  "_comment": "Ultra Low Memory Config - 8GB RAM + RTX 3060 (8GB VRAM)",
  "_expected_ram_usage": "~5-6 GB",
  "_training_time": "~24-30 hours for 10k steps",

  "experiment": {
    "name": "ultra_low_8gb",
    "seed": 42
  },
  "training": {
    "sft_warmstart": {
      "enabled": false
    },
    "ppo": {
      "batch_size": 1,
      "num_generations": 1,
      "gradient_accumulation_steps": 8,
      "learning_rate": 1.41e-5
    },
    "schedule": {
      "total_steps": 10000,
      "eval_steps": 1000,
      "save_steps": 2000,
      "logging_steps": 20
    }
  },
  "dataset": {
    "preprocessing": {
      "max_length": 512
    },
    "loader": {
      "batch_size": 1,
      "num_workers": 1
    }
  },
  "experiment": {
    "logging": {
      "use_wandb": true
    }
  }
}
